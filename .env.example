# Database Configuration
POSTGRES_HOST=localhost
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=ledger
POSTGRES_PORT=5434
POSTGRES_HOST_PORT=5434

# Application Configuration
PORT=8080
ENV=development

# Database URL (will be automatically constructed, but can be overridden)
# DATABASE_URL=postgres://postgres:postgres@localhost:5432/cashflow?sslmode=disable

ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
REFRESH_TOKEN_SESSION_TTL_DAYS=7
REFRESH_COOKIE_SECURE=false
REFRESH_COOKIE_SAMESITE=Lax

OAUTH_REDIRECT_ALLOWLIST=http://localhost:3000
OAUTH_REDIRECT_ALLOWLIST_DEVELOPMENT=http://localhost:3000
OAUTH_REDIRECT_ALLOWLIST_PRODUCTION=https://app.example.com

# OAuth Providers
GOOGLE_CLIENT_ID="your-client-id-goes-here"
GOOGLE_CLIENT_SECRET="your-client-secret-goes-here"
GOOGLE_REDIRECT_URL=http://localhost:8080/auth/oauth/google/callback
GITHUB_CLIENT_ID="your-client-id-goes-here"
GITHUB_CLIENT_SECRET="your-client-secret-goes-here"
GITHUB_REDIRECT_URL=http://localhost:8080/auth/oauth/github/callback

# Frontend (Nuxt)
NUXT_PUBLIC_OAUTH_BASE_URL=http://localhost:8080
